# Copy this file to .env and fill in the values. Never commit .env.

# Docker Hub user that owns the images (e.g. cataparrag)
DOCKERHUB_USER=tu-usuario-dockerhub
IMAGE_TAG=latest

# Public address of the server, without a trailing slash (e.g. http://54.12.34.56)
SIGA_PUBLIC_URL=http://localhost

# Database
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=cambia-esta-clave

# Keycloak administration console (http://<server>/auth)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambia-esta-clave
